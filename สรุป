การทำงานกับฟังก์ชัน
นิยาม : ฟังก์ชันคือส่วนของโค้ดที่สามารถนำกลับมาใช้ซ้ำได้ โดยรับอินพุต (อาร์กิวเมนต์) และส่งคืนค่าเอาต์พุต ในการเรียกใช้ฟังก์ชัน คุณต้องอ้างอิงถึงชื่อฟังก์ชันตามด้วยวงเล็บ:
# Defining a function

def get_sum(num_1, num_2):
    return num_1 + num_2

result = get_sum(3, 4) # function call
print(result) # 7
หากฟังก์ชันไม่ได้ระบุค่าส่งคืนอย่างชัดเจน ค่าส่งคืนเริ่มต้นจะเป็นNone:

def greet():
    print('hello') 

result = greet() # hello
print(result) # None
นอกจากนี้ คุณยังสามารถกำหนดค่าเริ่มต้นให้กับพารามิเตอร์ได้ดังนี้:

def get_sum(num_1, num_2=2):
    return num_1 + num_2

result = get_sum(3) 
print(result) # 5
หากคุณเรียกใช้ฟังก์ชันโดยไม่ระบุจำนวนอาร์กิวเมนต์ที่ถูกต้อง คุณจะได้รับข้อความแสดงข้อผิดพลาดTypeError:

def calculate_sum(a, b):
    print(a + b)

calculate_sum()

# TypeError: calculate_sum() missing 2 required positional arguments: 'a' and 'b'
ฟังก์ชันพื้นฐานทั่วไป
input()ฟังก์ชัน : ฟังก์ชันนี้ใช้สำหรับแจ้งให้ผู้ใช้ป้อนข้อมูลบางอย่าง:
name = input('What is your name?') # User types 'Kolade' and presses Enter  
print('Hello', name) # Hello Kolade
int()ฟังก์ชัน : ฟังก์ชันนี้ใช้สำหรับแปลงตัวเลข ค่าบูลีน หรือสตริงตัวเลข ให้เป็นจำนวนเต็ม:
print(int(3.14)) # 3
print(int('42')) # 42
print(int(True)) # 1
print(int(False)) # 0 
ขอบเขตในภาษา Python
ขอบเขตการใช้งานเฉพาะที่ (Local Scope ): คือกรณีที่ตัวแปรที่ประกาศไว้ภายในฟังก์ชันหรือคลาส จะสามารถเข้าถึงได้เฉพาะภายในฟังก์ชันหรือคลาสนั้นเท่านั้น
def my_func():
    num = 10
    print(num)
ขอบเขตการครอบคลุม : นี่คือกรณีที่ฟังก์ชันที่ซ้อนอยู่ภายในฟังก์ชันอื่น สามารถเข้าถึงตัวแปรของฟังก์ชันที่มันซ้อนอยู่ภายในได้
def outer_func():
    msg = 'Hello there!'
    
    def inner_func():
        print(msg)
    inner_func()

print(outer_func()) # Hello there!
ขอบเขตทั่วโลก (Global Scope ): หมายถึงตัวแปรที่ประกาศอยู่นอกฟังก์ชันหรือคลาสใดๆ ซึ่งสามารถเข้าถึงได้จากทุกที่ในโปรแกรม
tax = 0.70 

def get_total(subtotal):
    total = subtotal + (subtotal * tax)
    return total

print(get_total(100))  # 170.0
ขอบเขตในตัว (Built-in Scope) : ชื่อที่สงวนไว้ใน Python สำหรับฟังก์ชัน โมดูล คีย์เวิร์ด และอ็อบเจ็กต์ที่กำหนดไว้ล่วงหน้า
print(str(45)) # '45'
print(type(3.14)) # <class 'float'>
print(isinstance(3, str)) # False
ตัวดำเนินการเปรียบเทียบ
เท่ากับ ( ==) : ตรวจสอบว่าค่าสองค่าเท่ากันหรือไม่:
print(3 == 4) # False
ไม่เท่ากัน ( !=) : ตรวจสอบว่าค่าสองค่าไม่เท่ากันหรือไม่:
print(3 != 4) # True
มากกว่าอย่างเคร่งครัด ( >) : ตรวจสอบว่าค่าหนึ่งมากกว่าอีกค่าหนึ่งหรือไม่:
print(3 > 4) # False
น้อยกว่าอย่างเคร่งครัด ( <) : ตรวจสอบว่าค่าหนึ่งน้อยกว่าอีกค่าหนึ่งหรือไม่:
print(3 < 4) # True
มากกว่าหรือเท่ากับ( >=) : ตรวจสอบว่าค่าหนึ่งมากกว่าหรือเท่ากับอีกค่าหนึ่งหรือไม่:
print(3 >= 4) # False
น้อยกว่าหรือเท่ากับ( <=) : ตรวจสอบว่าค่าหนึ่งน้อยกว่าหรือเท่ากับอีกค่าหนึ่งหรือไม่:
print(3 <= 4) # True
การทำงานร่วมกับifและelifข้อความelseต่างๆ
ifคำสั่ง : คำสั่งเหล่านี้คือเงื่อนไขที่ใช้ในการตรวจสอบว่าสิ่งใดเป็นจริงหรือไม่ ถ้าเงื่อนไขนั้นเป็นจริงTrueโค้ดส่วนนั้นก็จะทำงาน
age = 18

if age >= 18:
    print('You are an adult') # You are an adult
elifเงื่อนไข (Claim ): คือเงื่อนไขที่อยู่หลังifคำสั่งelifเงื่อนไขจะทำงานได้ก็ต่อเมื่อเงื่อนไขก่อนหน้าทั้งหมดมีค่าเป็นจริงFalseและเงื่อนไขของเงื่อนไขเองก็มีค่าเป็นจริงเช่นTrueกัน
age = 16

if age >= 18:
    print('You are an adult')
elif age >= 13:
    print('You are a teenager')  # You are a teenager
elseข้อความนี้จะทำงานก็ต่อเมื่อไม่มีเงื่อนไขอื่นใดที่ประเมินค่าได้เป็นTrue.
age = 12

if age >= 18:
    print('You are an adult')
elif age >= 13:
    print('You are a teenager')
else:
    print('You are a child')  # You are a child
คุณสามารถใช้ifคำสั่งซ้อนกันได้ดังนี้:

is_citizen = True
age = 25

if is_citizen:
    if age >= 18:
        print('You are eligible to vote') # You are eligible to vote
else:
    print('You are not eligible to vote')
ค่าความจริงและค่าเท็จ
คำจำกัดความ : ในภาษา Python ทุกค่าจะมีค่าบูลีนโดยกำเนิด หรือมีความหมายในตัวว่าควรได้รับการพิจารณาว่าเป็นจริงTrueหรือFalseเท็จในบริบทเชิงตรรกะ ค่าหลายค่าถือว่าเป็นค่าที่เป็นจริง (truthy) กล่าวคือ เมื่อประเมินค่าแล้วจะได้ค่าเป็นจริงTrueในบริบทเชิงตรรกะ ส่วนค่าอื่นๆ ถือว่าเป็นค่าเท็จ (falsy) หมายความว่าเมื่อประเมินค่าแล้วจะได้Falseค่าเป็นเท็จ ตัวอย่างของค่าเท็จมีดังนี้:
None
False
Integer 0
Float 0.0
Empty strings ''
ค่าอื่นๆ เช่น ตัวเลขที่ไม่ใช่ศูนย์ และสตริงที่ไม่ว่างเปล่า ถือเป็นค่าความจริง

การทำงานร่วมกับbool()ฟังก์ชัน
คำจำกัดความ : หากคุณต้องการตรวจสอบว่าค่าใดเป็นจริงหรือเท็จ คุณสามารถใช้ฟังก์ชันในตัวได้bool()ฟังก์ชันนี้จะแปลงค่าเป็นค่าบูลีนโดยตรง และส่งคืนTrueค่าจริงสำหรับค่าที่เป็นจริง และFalseค่าเท็จสำหรับค่าที่เป็นเท็จ ต่อไปนี้เป็นตัวอย่างบางส่วน:
print(bool(False)) # False
print(bool(0))  # False
print(bool('')) # False

print(bool(True)) # True
print(bool(1)) # True
print(bool('Hello')) # True
ตัวดำเนินการบูลีนและการลัดวงจร
คำจำกัดความ : ตัวดำเนินการเหล่านี้เป็นตัวดำเนินการพิเศษที่ช่วยให้คุณสามารถรวมนิพจน์หลายๆ ตัวเข้าด้วยกันเพื่อสร้างตรรกะการตัดสินใจที่ซับซ้อนยิ่งขึ้นในโค้ดของคุณ ใน Python มีตัวดำเนินการบูลีนสามตัว ได้แก่ `true`, `false`, `false` andและor` notfalse`
andตัวดำเนินการ : ตัวดำเนินการนี้รับตัวถูกดำเนินการสองตัว และจะคืนค่าตัวถูกดำเนินการตัวแรกหากเป็นค่าเท็จ มิฉะนั้นจะคืนค่าตัวถูกดำเนินการตัวที่สอง ตัวถูกดำเนินการทั้งสองต้องเป็นค่าจริงจึงจะได้ผลลัพธ์เป็นค่าจริง
is_citizen = True
age = 25

print(is_citizen and age) # 25
คุณสามารถใช้andตัวดำเนินการในเงื่อนไขได้ดังนี้:

is_citizen = True
age = 25

if is_citizen and age >= 18:
    print('You are eligible to vote') # You are eligible to vote
else:
    print('You are not eligible to vote')
orตัวดำเนินการ : ตัวดำเนินการนี้จะคืนค่าตัวถูกดำเนินการตัวแรกหากเป็นค่าที่เป็นจริง มิฉะนั้นจะคืนค่าตัวถูกดำเนินการตัวที่สองorนิพจน์จะมีค่าเป็นจริงก็ต่อเมื่อมีตัวถูกดำเนินการอย่างน้อยหนึ่งตัวเป็นค่าที่เป็นจริง นี่คือตัวอย่าง:
age = 19
is_employed = False

print(age or is_employed) # 19
เช่นเดียวกับandตัวดำเนินการ คุณสามารถใช้orตัวดำเนินการในเงื่อนไขได้ดังนี้:

age = 19
is_student = True

if age < 18 or is_student:
    print('You are eligible for a student discount') # You are eligible for a student discount
else:
    print('You are not eligible for a student discount')
การทำงานแบบลัดวงจร : ตัวดำเนินการ and`and` orเป็นที่รู้จักกันในชื่อตัวดำเนินการแบบลัดวงจร การทำงานแบบลัดวงจรหมายความว่า Python ตรวจสอบค่าจากซ้ายไปขวาและหยุดทันทีที่ได้ผลลัพธ์สุดท้าย
notตัวดำเนินการ : ตัวดำเนินการนี้รับตัวถูกดำเนินการเพียงตัวเดียวและกลับค่าบูลีนของมัน โดยจะแปลงค่าที่เป็นจริง (truthy) เป็นFalseค่าเท็จ (falsy) เป็นค่าบวก (false True) แตกต่างจากตัวดำเนินการก่อนหน้านี้ที่เราได้ดูไป ตัวดำเนินการนี้ จะคืนค่าเป็นจริง หรือ เท็จ notเสมอนี่คือตัวอย่างบางส่วน:TrueFalse
print(not '') # True, because empty string is falsy
print(not 'Hello') # False, because non-empty string is truthy
print(not 0) # True, because 0 is falsy
print(not 1) # False, because 1 is truthy
print(not False) # True, because False is falsy
print(not True) # False, because True is truthy
ต่อไปนี้เป็นตัวอย่างnotการใช้ตัวดำเนินการในเงื่อนไข:

is_admin = False

if not is_admin:
    print('Access denied for non-administrators.') # Access denied for non-administrators.
else:
    print('Welcome, Administrator!')
